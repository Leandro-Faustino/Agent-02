# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Modelo de linguagem (RF-31: provedor atrás de interface própria)
ANTHROPIC_API_KEY=
LLM_MODEL_WRITER=claude-opus-5-5
LLM_MODEL_CLASSIFIER=claude-opus-5-5

# Embeddings para a base de conhecimento (opcional; sem chave usa busca textual)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Transcrição de áudio (RF-35) — endpoint compatível com multipart "file" → {"text": "..."}
TRANSCRIPTION_URL=
TRANSCRIPTION_API_KEY=

# WhatsApp Cloud API (segredos por empresa ficam na tabela whatsapp_numbers)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Autenticação dos workers chamados pelo pg_cron
CRON_SECRET=
